{
  "expo": {
    "name": "Cookmate",
    "slug": "cookmate",
    "scheme": "cookmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.drishix.cookmate",
      "supportsTablet": false
    },
    "android": {
      "package": "com.drishix.cookmate",
      "adaptiveIcon": {
        "backgroundColor": "#9ED22A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cookmate listens for \"next\", \"repeat\" and timers while you cook hands-free.",
          "speechRecognitionPermission": "Cookmate turns what you say while cooking into next, back, repeat and timers, on this phone when it can.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
