{
  "expo": {
    "name": "Cookmate",
    "slug": "cookmate",
    "scheme": "cookmate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.drishix.cookmate",
      "supportsTablet": false
    },
    "android": {
      "package": "com.drishix.cookmate",
      "adaptiveIcon": {
        "backgroundColor": "#9ED22A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
